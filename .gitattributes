# 自动检测文本并归一化（入库一律 LF）
* text=auto

# 行尾必须是 LF，否则本机 gofmt -l 会把整个包判成「未格式化」：
# GitHub 的 windows runner 默认 core.autocrlf=true，签出来就是 CRLF。
# 显式 eol=lf 覆盖 autocrlf，保证 CI 与开发机看到的字节一致。
*.go    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
*.rs    text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.lock  text eol=lf

# Windows 侧脚本/安装包脚本保持 CRLF
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.nsi   text eol=crlf
*.nsh   text eol=crlf

# 二进制
*.png   binary
*.ico   binary
*.icns  binary
*.exe   binary
*.dll   binary
*.zip   binary
