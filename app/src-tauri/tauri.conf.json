{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sun_Tey",
    "mainBinaryName": "Sun_Tey",
  "version": "0.1.0",
  "identifier": "com.suntey.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sun_Tey",
        "width": 900,
        "height": 640,
        "minWidth": 560,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../core/bin/suntey-core.exe": "binaries/suntey-core.exe",
      "../../core/binaries/ffmpeg.exe": "binaries/ffmpeg.exe",
      "../../extension": "extension"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
